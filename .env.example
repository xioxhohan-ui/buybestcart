# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Website Base URL
NEXT_PUBLIC_SITE_URL=https://bestbuycart.com

# Amazon Associates Configuration
NEXT_PUBLIC_AMAZON_TAG_US=bestbuycart-20
NEXT_PUBLIC_AMAZON_TAG_UK=bestbuycartuk-21
NEXT_PUBLIC_AMAZON_TAG_CA=bestbuycartca-20
NEXT_PUBLIC_AMAZON_TAG_DE=bestbuycartde-21
NEXT_PUBLIC_AMAZON_TAG_FR=bestbuycartfr-21
NEXT_PUBLIC_AMAZON_TAG_IT=bestbuycartit-21
NEXT_PUBLIC_AMAZON_TAG_ES=bestbuycartes-21
NEXT_PUBLIC_AMAZON_TAG_NL=bestbuycartnl-21
NEXT_PUBLIC_AMAZON_TAG_SE=bestbuycartse-21
NEXT_PUBLIC_AMAZON_TAG_PL=bestbuycartpl-21
NEXT_PUBLIC_AMAZON_TAG_AU=bestbuycartau-22

# Amazon Product Advertising API (PA-API v5)
AMAZON_PAAPI_ACCESS_KEY=YOUR_PAAPI_ACCESS_KEY
AMAZON_PAAPI_SECRET_KEY=YOUR_PAAPI_SECRET_KEY
AMAZON_PAAPI_PARTNER_TAG=bestbuycart-20

# Admin Master Route & Auth
ADMIN_PATH=/shohan
SESSION_SECRET=YOUR_SESSION_ENCRYPTION_KEY

# Email / SMTP Settings
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@bestbuycart.com
SMTP_PASS=YOUR_SMTP_PASSWORD
